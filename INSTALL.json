{
  "schema_version": 1,
  "name": "game-exp",
  "version": "1.5.1",
  "source_of_truth": "https://github.com/siskosun/game-exp",
  "policy": {
    "default_update_scope": "current_harness_only",
    "updates_other_harnesses": false,
    "updates_consumer_repositories": false,
    "repository_binding": "dynamic",
    "use_all_only_with_explicit_user_request": true,
    "downgrade_requires_explicit_override": true,
    "default_install_channel": "stable",
    "main_is_development_only": true
  },
  "harnesses": {
    "codex": {
      "install_or_upgrade": [
        "python",
        "tools/game-exp/install_harnesses.py",
        "--harness",
        "codex",
        "--json"
      ],
      "runtime": "~/.game-exp/runtimes/codex",
      "skill": "~/.codex/skills/game-exp",
      "config": "~/.codex/config.toml",
      "check": [
        "python",
        "tools/game-exp/install_harnesses.py",
        "--harness",
        "codex",
        "--check",
        "--json"
      ]
    },
    "qoder": {
      "install_or_upgrade": [
        "python",
        "tools/game-exp/install_harnesses.py",
        "--harness",
        "qoder",
        "--json"
      ],
      "runtime": "~/.game-exp/runtimes/qoder",
      "skill": "~/.qoder/skills/game-exp",
      "config": "~/.qoder/settings.json",
      "check": [
        "python",
        "tools/game-exp/install_harnesses.py",
        "--harness",
        "qoder",
        "--check",
        "--json"
      ]
    },
    "cursor": {
      "install_or_upgrade": [
        "python",
        "tools/game-exp/install_harnesses.py",
        "--harness",
        "cursor",
        "--json"
      ],
      "runtime": "~/.game-exp/runtimes/cursor",
      "skill": "~/.cursor/skills/game-exp",
      "config": "~/.cursor/mcp.json",
      "check": [
        "python",
        "tools/game-exp/install_harnesses.py",
        "--harness",
        "cursor",
        "--check",
        "--json"
      ]
    }
  },
  "explicit_all": [
    "python",
    "tools/game-exp/install_harnesses.py",
    "--harness",
    "all",
    "--json"
  ],
  "prerequisites": [
    "python>=3.11",
    "uv",
    "git",
    "gh (GitHub CLI, authenticated)"
  ],
  "notes_zh": [
    "默认安装/升级通道为 stable：安装器解析 GitHub 最新已发布、非预发布的语义版本 Release，并从该 Release 对应 Tag 的源码归档安装；不会默认安装 main。",
    "只有显式 --channel development 才使用当前 checkout（包括 main）；显式 --release vX.Y.Z 可安装指定正式 Release，若构成降级仍需 --allow-downgrade。",
    "CLI、本地 stdio MCP 和 project-create 依赖已登录的 GitHub CLI（gh）；先执行 gh auth login。",
    "安装与升级使用同一命令。",
    "默认只更新当前 Harness；不要顺带更新其他 Harness。",
    "安装或升级当前 Harness 的 game-exp 时，会从两个独立 GitHub 仓库读取最新语义版本标签，并同步当前 Harness 下的 Godot Prototype Studio 与 H5 Game Prototype Agent；不会联动修改其他 Harness。",
    "安装/升级对 game-exp runtime、Skill、MCP 配置以及 GPS/H5 两个伴随 Skill 使用事务回滚；任一步失败时恢复受管目标到安装前状态。",
    "同版本 CURRENT 不再只比较版本号；还会核对托管运行时摘要、必需入口、game-exp Skill 和当前 Harness MCP 配置。",
    "不要在普通升级中同步 toy2game、game-exp-sandbox 或其他消费仓库。",
    "全局 MCP 保持动态仓库绑定，运行时显式传入当前 owner/repo。",
    "可先使用 --check 只读判断 NOT_INSTALLED / CURRENT / UPGRADE_AVAILABLE；不会写文件。",
    "若源版本低于已安装版本，默认拒绝降级；仅显式回滚时使用 --allow-downgrade。",
    "检测到 0.17.x 及更早的共享安装时，单 Harness 升级只报告并保留旧共享副本，不会删除其他 Harness 可能仍在使用的文件。",
    "只有显式 --harness all --cleanup-legacy-shared 才会在三个独立运行时安装成功后删除旧 ~/.agents 共享 runtime/Skill。",
    "可运行 distribution_check.py 验证版本、来源、Harness 隔离升级和源文件完整性未漂移。",
    "1.5.0 默认 MCP 工具面为 27 个日常/只读工具；实验详情、原型详情和协作动态默认可用，但不会因此自动上浮或轮询。高级模式仅额外开放 project-preflight 与通用 request-submit。工具可用性与界面展示时机分离。",
    "1.2 在公开仓库的原型 handoff 中优先请求由 GPS/H5 发布不可变 GitHub Pages 试玩地址；game-exp 只记录和展示，不承担托管。",
    "1.2.1 将 game-exp-pages.yml 作为受管工作流安装到目标仓库：原型执行器写入不可变静态版本后，由 GitHub Actions Pages 工作流完成部署。",
    "1.3.0 增加同实验版本修订 A/B：面板可对当前 Candidate 与受保护历史中的紧邻上一 Candidate 做版本 A/B 盲测，偏好只能随显式 Review PASS/FAIL 一并记录，不自动晋级、评分或选中。"
  ],
  "explicit_all_check": [
    "python",
    "tools/game-exp/install_harnesses.py",
    "--harness",
    "all",
    "--check",
    "--json"
  ],
  "legacy_shared_install": {
    "detect_runtime": "~/.agents/tools/game-exp",
    "detect_skill": "~/.agents/skills/game-exp",
    "single_harness_behavior": "detect_and_preserve",
    "cleanup_requires_explicit_all": true,
    "cleanup_command": [
      "python",
      "tools/game-exp/install_harnesses.py",
      "--harness",
      "all",
      "--cleanup-legacy-shared",
      "--json"
    ]
  },
  "distribution_check": [
    "python",
    "tools/game-exp/distribution_check.py",
    "--json"
  ],
  "companion_skill_sync": {
    "mode": "latest_semver_tag",
    "same_harness_only": true,
    "skills": [
      {
        "name": "godot-prototype-studio",
        "source": "https://github.com/siskosun/godot-prototype-studio"
      },
      {
        "name": "h5-game-prototype-agent",
        "source": "https://github.com/siskosun/h5-game-prototype-agent"
      }
    ],
    "runtime_filter": "skill-runtime-allowlist",
    "unversioned_source_policy": "reject",
    "failure_policy": "fail_install_command_with_explicit_error"
  },
  "source_selection": {
    "default_channel": "stable",
    "stable_selector": "latest_published_non_prerelease_semver_release",
    "explicit_release_supported": true,
    "explicit_release_argument": "--release vX.Y.Z",
    "development_requires_explicit_channel": true,
    "development_argument": "--channel development",
    "main_policy": "development_only",
    "stable_archive": "GitHub Release tag source archive",
    "provenance_fields": [
      "source_channel",
      "source_ref",
      "release_url",
      "source_digest"
    ]
  }
}
